# Default production backend; use memory explicitly for a local demonstration.
DATA_PROVIDER=oracle
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
# Production: exact HTTPS frontend origins, comma-separated. For separate sites,
# use none only after validating browser cookies with the deployed HTTPS API.
REFRESH_COOKIE_SAME_SITE=strict
# Optional hosted HTTPS URL ending in /api/v1; Render derives its assigned URL.
PUBLIC_API_URL=
# Generate independent random values (at least 32 characters).
JWT_SECRET=
SETUP_TOKEN=
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_CONNECTION_MODE=TLS
# Assistant uses BASE64 for exact password punctuation; encoding is not encryption.
ORACLE_PASSWORD_BASE64=
ORACLE_CONFIG_DIR=
ORACLE_WALLET_LOCATION=
ORACLE_WALLET_PASSWORD=
ORACLE_WALLET_PASSWORD_BASE64=
# Only db:seed uses this; no default password.
SEED_OWNER_PASSWORD=
