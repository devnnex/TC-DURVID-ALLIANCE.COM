[Unit]
Description=Avisos de insumos TC-DURVID
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alliance
WorkingDirectory=/srv/tc-alliance
EnvironmentFile=/srv/tc-alliance/.env
ExecStart=/usr/bin/npm run notifications:worker
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
